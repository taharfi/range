# Server-only settings. No NEXT_PUBLIC secrets, signing keys or seed phrases.
SOLANA_RPC_URL=https://api.mainnet.solana.com
# Optional free Jupiter developer key; omit for keyless 0.5 RPS reads.
JUPITER_API_KEY=
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_SECRET=
# Facilitator issues one random code per genuine LP tester. Never use wallet addresses.
PILOT_TESTER_CODES=
# Optional local building access; requires PILOT_DEPLOYMENT=local and loopback origin.
# Unlimited repeated analyses without the personal 6/min cap; shared provider safeguards remain.
# PILOT_DEVELOPMENT_CODE=
# Local persistent directory, excluded from git. Requires a persistent volume when hosted.
PILOT_FEEDBACK_DIR=.pilot-feedback
# Optional canonical origin when a reverse proxy changes the internal host/protocol.
# PILOT_PUBLIC_ORIGIN=https://your-pilot.example.com
