{$PILOT_SITE_ADDRESS} {
    encode zstd gzip
    request_body {
        max_size 8KB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy app:3000 {
        # Overwrite any incoming spoofed header. App is reachable only on this network.
        header_up X-Pilot-Client-IP {remote_host}
        transport http {
            response_header_timeout 120s
        }
    }
    # No access log. Operational errors can contain connection metadata; never enable body/cookie logs.
}
