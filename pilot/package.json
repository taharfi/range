{
  "name": "lp-exit-intelligence-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "smoke:live": "node --env-file-if-exists=.env.local --import tsx scripts/live-smoke.ts",
    "smoke:browser": "node --env-file-if-exists=.env.local --import tsx scripts/browser-live-smoke.ts",
    "pilot:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/pilot-live-preflight.ts",
    "pilot:summary": "node --env-file-if-exists=.env.local --import tsx scripts/pilot-summary.ts",
    "pilot:usage": "node --env-file-if-exists=.env.local scripts/ops.mjs summary",
    "pilot:purge": "node --env-file-if-exists=.env.local scripts/ops.mjs purge"
    ,"audit:build":"node --env-file-if-exists=.env.local scripts/audit-build.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "bs58": "6.0.0",
    "decimal.js": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "tsx": "4.23.15"
  }
}
