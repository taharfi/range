# Runtime-only template. Placeholder values deliberately fail readiness checks.
PILOT_DEPLOYMENT=public
PILOT_REQUIRE_INVITE=1
PILOT_TRUST_PROXY=1
PILOT_PUBLIC_ORIGIN=https://pilot.example.invalid
PILOT_SITE_ADDRESS=pilot.example.invalid
# Keep local-only bindings until the user approves a public launch.
PILOT_HTTP_BIND=127.0.0.1:8080
PILOT_HTTPS_BIND=127.0.0.1:8443
FEEDBACK_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Exactly ten distinct codes, >=20 chars each in public mode. Never use wallet addresses.
PILOT_TESTER_CODES=REPLACE_WITH_TEN_COMMA_SEPARATED_RANDOM_CODES
PILOT_FEEDBACK_DIR=/app/private-data
PILOT_LEDGER_DIR=/app/private-data/ledger
SOLANA_RPC_URL=https://api.mainnet.solana.com
# Optional free developer API key. Never use NEXT_PUBLIC_ for secrets.
JUPITER_API_KEY=
